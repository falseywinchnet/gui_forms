form gallery.root {
  title: "GUI.Forms Gallery";
  min-size: 1280 820;
  // gallery.root is the declared boundary only. Its direct children are the
  // mounts the registry-driven shell (src/controls/gallery_pages.cpp) places:
  // the command strip across the top, one compiled-DML group per `page`, and
  // the diagnostics overlay. Navigation is derived from manifests/controls.json.

  command-strip gallery.command-strip {
    layout: flex-row;
    button gallery.command.reset { text: "Reset"; }
    button gallery.command.diagnostics { text: "Diagnostics"; toggle: true; }
    label gallery.command.status { text: "Portable core · Host 0.4 · drop-ready"; flex: 1; }
  }

  backplane gallery.backplane {
    page: basics;
    material: gallery-fresco;
    size: 660 200;
    group gallery.basics-group {
      text: "Basic controls";
      layout: form-grid;
      label gallery.intro {
        text: "Professional retained controls with deterministic native behavior.";
      }
      text-input gallery.text-input {
        text: "Edit this text";
        placeholder: "Type here";
      }
      button gallery.default-button { text: "Apply"; default: true; }
      button gallery.disabled-button { text: "Unavailable"; enabled: false; }
      checkbox gallery.checkbox { text: "Enable precise updates"; checked: true; }
      radio gallery.radio.classic { text: "Classic relief"; group: gallery.style-mode; checked: true; }
      radio gallery.radio.quiet { text: "Quiet relief"; group: gallery.style-mode; }
      link-label gallery.link { text: "Show control contract"; }
      checkbox gallery.checkbox.indeterminate {
        text: "Three-state option";
        three-state: true;
        state: indeterminate;
      }
      user-control gallery.lifecycle-card {
        label gallery.lifecycle-title { text: "COMPOSED"; }
        label gallery.lifecycle-status { text: "Awaiting attach"; }
      }
    }
  }

  group gallery.values-group {
    page: values;
    text: "Values and retained state";
    size: 660 116;
    slider gallery.slider { minimum: 0; maximum: 100; value: 42; }
    progress gallery.progress { minimum: 0; maximum: 100; value: 42; }
    label gallery.value-label { text: "42%"; }
  }

  group gallery.collection-group {
    page: retained-rows;
    text: "Retained collection";
    size: 660 144;
    list gallery.collection {
      row gallery.collection.alpha { text: "Alpha channel"; selected: true; }
      row gallery.collection.beta { text: "Beta channel"; }
      row gallery.collection.gamma { text: "Gamma channel"; }
      row gallery.collection.delta { text: "Delta channel"; }
    }
  }

  group gallery.instrument-group {
    page: instrument;
    text: "Custom instrument";
    size: 660 150;
    instrument gallery.instrument { value: 0.42; }
  }

  diagnostics gallery.diagnostics {
    text: "Diagnostics";
    width: 280;
    visible: false;
    label gallery.diagnostics.about { text: "GUI.Forms Gallery"; wrap: true; }
    label gallery.diagnostics.renderer { text: "renderer"; }
    label gallery.diagnostics.controls { text: "controls"; }
    label gallery.diagnostics.layout { text: "measure / arrange"; }
    label gallery.diagnostics.paint { text: "paint / damage"; }
    label gallery.diagnostics.input { text: "input / focus / activation"; }
    label gallery.diagnostics.flush { text: "wake / ticks / active"; }
    label gallery.diagnostics.present { text: "present / worst"; }
    label gallery.diagnostics.font {
      text: "Controls: Portsmouth Rapids 1.0; Fields: Carlito body specimen.";
    }
  }
}

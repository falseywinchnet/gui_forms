+// Two independent adjacent groups share the first-stage coefficient. Pack
+// their left/right values in registers; storage stays in its original order.
+// The stage contract supplies an even size and disjoint real/imaginary arrays.
+void sse2_first_stage(double* const real, double* const imaginary,
+                      const double* const cosine, const double* const sine,
+                      const std::size_t size) noexcept {
+    const std::size_t paired = size - size % 4;
+    const __m128d c = _mm_set1_pd(cosine[0]);
+    const __m128d s = _mm_set1_pd(sine[0]);
+    for (std::size_t base = 0; base < paired; base += 4) {
+        const __m128d real_first = _mm_loadu_pd(real + base);
+        const __m128d real_second = _mm_loadu_pd(real + base + 2);
+        const __m128d imaginary_first = _mm_loadu_pd(imaginary + base);
+        const __m128d imaginary_second = _mm_loadu_pd(imaginary + base + 2);
+        const __m128d lr = _mm_unpacklo_pd(real_first, real_second);
+        const __m128d rr = _mm_unpackhi_pd(real_first, real_second);
+        const __m128d li = _mm_unpacklo_pd(imaginary_first, imaginary_second);
+        const __m128d ri = _mm_unpackhi_pd(imaginary_first, imaginary_second);
+        const __m128d pr = _mm_sub_pd(_mm_mul_pd(rr, c), _mm_mul_pd(ri, s));
+        const __m128d pi = _mm_add_pd(_mm_mul_pd(rr, s), _mm_mul_pd(ri, c));
+        const __m128d real_sum = _mm_add_pd(lr, pr);
+        const __m128d real_difference = _mm_sub_pd(lr, pr);
+        const __m128d imaginary_sum = _mm_add_pd(li, pi);
+        const __m128d imaginary_difference = _mm_sub_pd(li, pi);
+        _mm_storeu_pd(real + base, _mm_unpacklo_pd(real_sum, real_difference));
+        _mm_storeu_pd(real + base + 2, _mm_unpackhi_pd(real_sum, real_difference));
+        _mm_storeu_pd(imaginary + base, _mm_unpacklo_pd(imaginary_sum, imaginary_difference));
+        _mm_storeu_pd(imaginary + base + 2, _mm_unpackhi_pd(imaginary_sum, imaginary_difference));
+    }
+    if (paired != size) {
+        scalar_butterfly(real + paired, imaginary + paired, cosine, sine, 1, size - paired);
+    }
+}

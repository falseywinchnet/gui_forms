 namespace {
 constexpr std::size_t maximum_page = 65307;
+constexpr std::array<std::uint32_t, 256> make_crc_table() noexcept {
+    std::array<std::uint32_t, 256> table{};
+    for (std::size_t index = 0; index < table.size(); ++index) {
+        std::uint32_t value = static_cast<std::uint32_t>(index) << 24;
+        for (unsigned int bit = 0; bit < 8; ++bit) {
+            const bool high = (value & 0x80000000U) != 0;
+            value <<= 1;
+            if (high) value ^= 0x04c11db7U;
+        }
+        table[index] = value;
+    }
+    return table;
+}
+// Ogg uses the non-reflected polynomial with zero initial/final XOR. Immutable
+// byte transitions replace eight bit transitions; checksum bytes stay zeroed.
+constexpr std::array<std::uint32_t, 256> crc_table = make_crc_table();
 std::uint32_t little32(const std::uint8_t* const bytes) noexcept {
     std::uint32_t value = 0;

# Stage F's font substitution table (assets/fonts/font-substitution.json).
#
# gui_forms_font_substitution_read() validates the table and returns the face
# files and licence files it names, for packaging. With an OUTPUT argument it
# also writes the fixed C++ record arrays that src/core/drawing/
# font_substitution/font_substitution.cpp includes. Both the configure step
# and the build-time generation (generate_font_substitution.cmake) call it,
# so one parser validates the file.

function(gui_forms_font_substitution_fail message)
    message(FATAL_ERROR "font-substitution.json: ${message}")
endfunction()

# A table string becomes a C++ string literal unescaped and a CMake list
# element, so only printable ASCII without quotes, backslashes or semicolons
# is admitted.
function(gui_forms_font_substitution_text value where)
    string(FIND "${value}" "\"" quote)
    string(FIND "${value}" "\\" backslash)
    string(FIND "${value}" ";" semicolon)
    if(value STREQUAL "" OR NOT value MATCHES "^[ -~]+$" OR NOT quote EQUAL -1 OR
       NOT backslash EQUAL -1 OR NOT semicolon EQUAL -1)
        gui_forms_font_substitution_fail("${where} must be nonempty printable ASCII without quotes, backslashes or semicolons")
    endif()
endfunction()

function(gui_forms_font_substitution_style_enum style where output)
    if(style STREQUAL "regular")
        set(${output} "regular" PARENT_SCOPE)
    elseif(style STREQUAL "bold")
        set(${output} "bold" PARENT_SCOPE)
    elseif(style STREQUAL "italic")
        set(${output} "italic" PARENT_SCOPE)
    elseif(style STREQUAL "bold_italic")
        set(${output} "bold_italic" PARENT_SCOPE)
    else()
        gui_forms_font_substitution_fail("${where} style '${style}' is not regular, bold, italic or bold_italic")
    endif()
endfunction()

# Usage: gui_forms_font_substitution_read(JSON <path> FONT_DIRECTORY <dir>
#            FILES <var> LICENCES <var> [OUTPUT <path>])
function(gui_forms_font_substitution_read)
    cmake_parse_arguments(PARSE_ARGV 0 table "" "JSON;FONT_DIRECTORY;FILES;LICENCES;OUTPUT" "")
    if(NOT EXISTS "${table_JSON}")
        gui_forms_font_substitution_fail("${table_JSON} is missing")
    endif()
    file(READ "${table_JSON}" json)

    string(JSON schema ERROR_VARIABLE failure GET "${json}" schema)
    if(failure OR NOT schema STREQUAL "gui_forms.font_substitution.v1")
        gui_forms_font_substitution_fail("schema must be gui_forms.font_substitution.v1")
    endif()
    string(JSON content_family ERROR_VARIABLE failure GET "${json}" content_family)
    if(failure)
        gui_forms_font_substitution_fail("content_family is missing")
    endif()

    # Bundled families and their faces. Names are compared lowercased; every
    # requested name must be unique across families and mappings.
    set(face_lines "")
    set(face_count 0)
    set(files "")
    set(licences "")
    set(known_names "")
    set(family_names "")
    set(content_found FALSE)
    string(JSON family_count ERROR_VARIABLE failure LENGTH "${json}" families)
    if(failure OR family_count EQUAL 0)
        gui_forms_font_substitution_fail("families must be a nonempty array")
    endif()
    math(EXPR last_family "${family_count} - 1")
    foreach(family_index RANGE ${last_family})
        string(JSON family GET "${json}" families ${family_index} family)
        gui_forms_font_substitution_text("${family}" "families[${family_index}].family")
        string(TOLOWER "${family}" folded)
        if(folded IN_LIST known_names)
            gui_forms_font_substitution_fail("family '${family}' is listed twice")
        endif()
        list(APPEND known_names "${folded}")
        list(APPEND family_names "${folded}")
        string(JSON licence GET "${json}" families ${family_index} licence)
        gui_forms_font_substitution_text("${licence}" "family '${family}' licence")
        if(NOT EXISTS "${table_FONT_DIRECTORY}/${licence}")
            gui_forms_font_substitution_fail("family '${family}' licence ${licence} is not in ${table_FONT_DIRECTORY}")
        endif()
        if(NOT licence IN_LIST licences)
            list(APPEND licences "${licence}")
        endif()
        string(JSON style_count LENGTH "${json}" families ${family_index} faces)
        if(style_count EQUAL 0)
            gui_forms_font_substitution_fail("family '${family}' has no faces")
        endif()
        set(styles "")
        math(EXPR last_face "${style_count} - 1")
        foreach(face_index RANGE ${last_face})
            string(JSON style GET "${json}" families ${family_index} faces ${face_index} style)
            string(JSON file GET "${json}" families ${family_index} faces ${face_index} file)
            gui_forms_font_substitution_style_enum("${style}" "family '${family}'" style_enum)
            if(style IN_LIST styles)
                gui_forms_font_substitution_fail("family '${family}' lists ${style} twice")
            endif()
            list(APPEND styles "${style}")
            gui_forms_font_substitution_text("${file}" "family '${family}' ${style} file")
            if(NOT EXISTS "${table_FONT_DIRECTORY}/${file}")
                gui_forms_font_substitution_fail("family '${family}' face ${file} is not in ${table_FONT_DIRECTORY}")
            endif()
            if(NOT file IN_LIST files)
                list(APPEND files "${file}")
            endif()
            string(APPEND face_lines
                "    {.family = \"${family}\", .style = FontFaceStyle::${style_enum}, .file = \"${file}\"},\n")
            math(EXPR face_count "${face_count} + 1")
        endforeach()
        if(NOT "regular" IN_LIST styles)
            gui_forms_font_substitution_fail("family '${family}' has no regular face")
        endif()
        string(TOLOWER "${content_family}" folded_content)
        if(folded STREQUAL folded_content)
            foreach(required regular bold italic bold_italic)
                if(NOT required IN_LIST styles)
                    gui_forms_font_substitution_fail("content family '${family}' lacks its ${required} face")
                endif()
            endforeach()
            set(content_found TRUE)
        endif()
    endforeach()
    if(NOT content_found)
        gui_forms_font_substitution_fail("content_family '${content_family}' is not a listed family")
    endif()

    # Substitutions, then aliases resolved to their substitution, then
    # generic names: one record array, matched in that order.
    set(mapping_lines "")
    set(exception_lines "")
    set(exception_count 0)
    set(mapping_count 0)
    set(substitution_names "")
    string(JSON substitution_count LENGTH "${json}" substitutions)
    if(substitution_count GREATER 0)
        math(EXPR last_substitution "${substitution_count} - 1")
        foreach(index RANGE ${last_substitution})
            string(JSON requested GET "${json}" substitutions ${index} requested)
            string(JSON family GET "${json}" substitutions ${index} family)
            string(JSON class GET "${json}" substitutions ${index} class)
            string(JSON evidence GET "${json}" substitutions ${index} evidence)
            gui_forms_font_substitution_text("${requested}" "substitutions[${index}].requested")
            gui_forms_font_substitution_text("${evidence}" "substitution '${requested}' evidence")
            string(TOLOWER "${requested}" folded)
            string(TOLOWER "${family}" folded_family)
            if(folded IN_LIST known_names)
                gui_forms_font_substitution_fail("'${requested}' is named twice")
            endif()
            if(NOT folded_family IN_LIST family_names)
                gui_forms_font_substitution_fail("substitution '${requested}' names unlisted family '${family}'")
            endif()
            if(NOT class STREQUAL "metric_compatible" AND NOT class STREQUAL "nearest")
                gui_forms_font_substitution_fail("substitution '${requested}' class must be metric_compatible or nearest")
            endif()
            list(APPEND known_names "${folded}")
            list(APPEND substitution_names "${folded}")
            set(substitution_family_${folded} "${family}")
            set(substitution_class_${folded} "${class}")
            set(substitution_request_${folded} "${requested}")
            set(substitution_evidence_${folded} "${evidence}")
            string(APPEND mapping_lines
                "    {.requested = \"${requested}\", .family = \"${family}\", "
                ".source = FontResolutionSource::substitution, .mapping = FontMappingClass::${class}, "
                ".measured_as = \"${requested}\", .evidence = \"${evidence}\"},\n")
            math(EXPR mapping_count "${mapping_count} + 1")

            # Named gate exceptions (stage F decisions 16 and 17): a criterion
            # this style may fail, within its limit.
            string(JSON listed_exceptions ERROR_VARIABLE failure LENGTH "${json}" substitutions ${index} exceptions)
            if(failure)
                gui_forms_font_substitution_fail("substitution '${requested}' has no exceptions array")
            endif()
            if(listed_exceptions GREATER 0)
                math(EXPR last_exception "${listed_exceptions} - 1")
                set(exception_keys "")
                foreach(exception_index RANGE ${last_exception})
                    string(JSON style GET "${json}" substitutions ${index} exceptions ${exception_index} style)
                    string(JSON criterion GET "${json}" substitutions ${index} exceptions ${exception_index} criterion)
                    string(JSON limit GET "${json}" substitutions ${index} exceptions ${exception_index} limit)
                    string(JSON limit_type TYPE "${json}" substitutions ${index} exceptions ${exception_index} limit)
                    string(JSON note GET "${json}" substitutions ${index} exceptions ${exception_index} note)
                    gui_forms_font_substitution_style_enum("${style}" "substitution '${requested}' exception" style_enum)
                    if(NOT criterion MATCHES "^(advances|line_breaks|line_height|line_width)$")
                        gui_forms_font_substitution_fail("substitution '${requested}' exception criterion '${criterion}' is unknown")
                    endif()
                    if(NOT limit_type STREQUAL "NUMBER" OR NOT limit MATCHES "^[0-9]+(\\.[0-9]+)?$")
                        gui_forms_font_substitution_fail("substitution '${requested}' exception limit '${limit}' is not a nonnegative number")
                    endif()
                    gui_forms_font_substitution_text("${note}" "substitution '${requested}' exception note")
                    if("${style}:${criterion}" IN_LIST exception_keys)
                        gui_forms_font_substitution_fail("substitution '${requested}' names ${style} ${criterion} twice")
                    endif()
                    list(APPEND exception_keys "${style}:${criterion}")
                    string(APPEND exception_lines
                        "    {.requested = \"${requested}\", .style = FontFaceStyle::${style_enum}, "
                        ".criterion = FontGateCriterion::${criterion}, .limit = ${limit}, .note = \"${note}\"},\n")
                    math(EXPR exception_count "${exception_count} + 1")
                endforeach()
            endif()
        endforeach()
    endif()

    string(JSON alias_count LENGTH "${json}" aliases)
    if(alias_count GREATER 0)
        math(EXPR last_alias "${alias_count} - 1")
        foreach(index RANGE ${last_alias})
            string(JSON requested GET "${json}" aliases ${index} requested)
            string(JSON same_as GET "${json}" aliases ${index} same_as)
            gui_forms_font_substitution_text("${requested}" "aliases[${index}].requested")
            string(TOLOWER "${requested}" folded)
            string(TOLOWER "${same_as}" target)
            if(folded IN_LIST known_names)
                gui_forms_font_substitution_fail("'${requested}' is named twice")
            endif()
            if(NOT target IN_LIST substitution_names)
                gui_forms_font_substitution_fail("alias '${requested}' names '${same_as}', which is not a substitution")
            endif()
            list(APPEND known_names "${folded}")
            string(APPEND mapping_lines
                "    {.requested = \"${requested}\", .family = \"${substitution_family_${target}}\", "
                ".source = FontResolutionSource::alias, .mapping = FontMappingClass::${substitution_class_${target}}, "
                ".measured_as = \"${substitution_request_${target}}\", "
                ".evidence = \"${substitution_evidence_${target}}\"},\n")
            math(EXPR mapping_count "${mapping_count} + 1")
        endforeach()
    endif()

    string(JSON generic_count LENGTH "${json}" generics)
    if(generic_count GREATER 0)
        math(EXPR last_generic "${generic_count} - 1")
        foreach(index RANGE ${last_generic})
            string(JSON requested GET "${json}" generics ${index} requested)
            string(JSON family GET "${json}" generics ${index} family)
            gui_forms_font_substitution_text("${requested}" "generics[${index}].requested")
            string(TOLOWER "${requested}" folded)
            string(TOLOWER "${family}" folded_family)
            if(folded IN_LIST known_names)
                gui_forms_font_substitution_fail("'${requested}' is named twice")
            endif()
            if(NOT folded_family IN_LIST family_names)
                gui_forms_font_substitution_fail("generic '${requested}' names unlisted family '${family}'")
            endif()
            list(APPEND known_names "${folded}")
            string(APPEND mapping_lines
                "    {.requested = \"${requested}\", .family = \"${family}\", "
                ".source = FontResolutionSource::generic, .mapping = FontMappingClass::none, "
                ".measured_as = \"\", .evidence = \"\"},\n")
            math(EXPR mapping_count "${mapping_count} + 1")
        endforeach()
    endif()
    if(mapping_count EQUAL 0)
        gui_forms_font_substitution_fail("the table maps no family")
    endif()

    if(table_OUTPUT)
        set(text "// Generated by cmake/FontSubstitution.cmake from assets/fonts/font-substitution.json.\n")
        string(APPEND text "// Do not edit; change the JSON file.\n\n")
        string(APPEND text "constexpr std::string_view generated_content_font_family{\"${content_family}\"};\n\n")
        string(APPEND text "constexpr std::array<BundledFontFace, ${face_count}> generated_bundled_font_faces{{\n")
        string(APPEND text "${face_lines}}};\n\n")
        string(APPEND text "constexpr std::array<FontSubstitution, ${mapping_count}> generated_font_substitutions{{\n")
        string(APPEND text "${mapping_lines}}};\n\n")
        if(exception_count EQUAL 0)
            string(APPEND text "constexpr std::array<FontGateException, 0> generated_gate_exceptions{};\n")
        else()
            string(APPEND text "constexpr std::array<FontGateException, ${exception_count}> generated_gate_exceptions{{\n")
            string(APPEND text "${exception_lines}}};\n")
        endif()
        # Rewritten only when the text changes, so a touched JSON file with the
        # same records does not rebuild the core.
        file(CONFIGURE OUTPUT "${table_OUTPUT}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
    endif()
    set(${table_FILES} "${files}" PARENT_SCOPE)
    set(${table_LICENCES} "${licences}" PARENT_SCOPE)
endfunction()

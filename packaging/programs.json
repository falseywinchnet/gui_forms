{
  "schema": 1,
  "notes": [
    "Program manifest consumed by tools/package_programs.py, tools/smoke_package.py and tools/publish_tested_release.py.",
    "Each program lists, per platform, the CMake target and the path pattern of what the build directory produces.",
    "A platform entry marked planned=true names a target another workstream still has to add; packaging logs it as skipped when the build directory lacks it and never fails on it.",
    "Font and notice lists mirror GUI_FORMS_GALLERY_FONTS / GUI_FORMS_GALLERY_FONT_NOTICES in CMakeLists.txt. macOS bundles embed them in Contents/Resources/fonts at build time; Windows post-build copies them to fonts/ beside the executable; Linux has no post-build copy yet, so packaging supplies fonts/ from assets/fonts.",
    "Identifiers: macOS pkg identifier is <vendor.bundle_prefix>.<id>; Debian package is <vendor.deb_prefix>-<id>; Windows uninstall key is <vendor.windows_uninstall_prefix><id> under HKCU."
  ],
  "vendor": {
    "name": "Rainstar",
    "maintainer": "Joshuah Rainstar <noreply@rainstar.invalid>",
    "repository": "falseywinchnet/gui_forms",
    "bundle_prefix": "org.rainstar.guiforms",
    "deb_prefix": "rainstar-guiforms",
    "windows_install_root": "$LOCALAPPDATA\\Rainstar\\GUI.Forms",
    "windows_uninstall_prefix": "RainstarGUIForms-",
    "linux_install_root": "/usr/lib/rainstar-guiforms",
    "artifact_prefix": "gui-forms"
  },
  "fonts": {
    "source": "assets/fonts",
    "files": [
      "PortsmouthRapids.ttf",
      "PortsmouthRapids-Bold.ttf",
      "Carlito-Regular.ttf",
      "Carlito-Bold.ttf",
      "Carlito-Italic.ttf",
      "Carlito-BoldItalic.ttf",
      "Cousine-Regular.ttf",
      "Cousine-Bold.ttf",
      "Cousine-Italic.ttf",
      "Cousine-BoldItalic.ttf",
      "NotoSansCJKjp-Regular.otf",
      "NotoEmoji-Regular.ttf",
      "NotoSansArabic-Regular.ttf",
      "NotoSansHebrew-Regular.ttf",
      "NotoSansDevanagari-Regular.ttf",
      "NotoSansBengali-Regular.ttf",
      "NotoSansGurmukhi-Regular.ttf"
    ],
    "notices": [
      "ATTRIBUTION.md",
      "OFL-Carlito.txt",
      "OFL-Cousine.txt",
      "OFL-Noto.txt",
      "OFL-NotoSansCJKjp.txt",
      "OFL-NotoEmoji.txt"
    ]
  },
  "programs": [
    {
      "id": "gallery",
      "display_name": "GUI.Forms Gallery",
      "description": "Native control gallery: twenty pages of stock GUI.Forms controls grouped by function from the control registry, live, with diagnostics.",
      "enabled": true,
      "status": "Registry-driven Gallery; the Complete Showcase's sixteen pages migrated into it (decision F.1) and its targets are retired.",
      "required_platforms": [
        "macos-arm64",
        "windows-x64"
      ],
      "automation_flag": "--automation",
      "smoke": {
        "mode": "survive",
        "seconds": 6,
        "expect_receipt": true,
        "extra_arguments": []
      },
      "platforms": {
        "macos-arm64": {
          "target": "gui_forms_gallery",
          "bundle": "GUI.Forms Gallery.app",
          "executable": "Contents/MacOS/GUI.Forms Gallery",
          "bundle_identifier": "local.guiforms.gallery",
          "fonts": "bundle-resources"
        },
        "windows-x64": {
          "target": "gui_forms_gallery_windows",
          "executable": "GUI.Forms Gallery.exe",
          "fonts": "sibling"
        },
        "linux-x64": {
          "target": "gui_forms_gallery_linux",
          "executable": "gui-forms-gallery",
          "fonts": "sibling",
          "planned": false
        },
        "linux-arm64": {
          "target": "gui_forms_gallery_linux",
          "executable": "gui-forms-gallery",
          "fonts": "sibling",
          "planned": false
        }
      }
    },
    {
      "id": "explore",
      "display_name": "GUI.Forms Explore (preview)",
      "description": "Fixture-backed file-manager mockup over public GUI.Forms seams (file_manager_demoboard). Preview: STATUS.md records D0-D6 as measured partial and D7/D8/D10 as not started.",
      "enabled": true,
      "status": "preview",
      "cmake_option": "GUI_FORMS_BUILD_FILE_MANAGER_DEMOBOARD",
      "required_platforms": [],
      "automation_flag": null,
      "smoke": {
        "mode": "survive",
        "seconds": 6,
        "expect_receipt": true,
        "extra_arguments": [
          "--product-only"
        ]
      },
      "platforms": {
        "macos-arm64": {
          "target": "gui_forms_file_manager_demoboard",
          "bundle": "File Manager Demoboard.app",
          "executable": "Contents/MacOS/File Manager Demoboard",
          "bundle_identifier": "local.guiforms.file-manager-demoboard",
          "fonts": "bundle-resources"
        },
        "windows-x64": {
          "target": "gui_forms_file_manager_demoboard_windows",
          "executable": "File Manager Demoboard.exe",
          "fonts": "sibling"
        },
        "linux-x64": {
          "target": "gui_forms_file_manager_demoboard_linux",
          "executable": "gui-forms-explore",
          "fonts": "sibling",
          "planned": false
        },
        "linux-arm64": {
          "target": "gui_forms_file_manager_demoboard_linux",
          "executable": "gui-forms-explore",
          "fonts": "sibling",
          "planned": false
        }
      }
    },
    {
      "id": "correspondence",
      "display_name": "GUI.Forms Correspondence",
      "description": "Mail-client mockup over in-memory fixtures (demo/correspondence); no real mail, filesystem or network.",
      "enabled": true,
      "status": "preview",
      "required_platforms": [
        "macos-arm64",
        "windows-x64"
      ],
      "automation_flag": "--automation",
      "smoke": {
        "mode": "survive",
        "seconds": 6,
        "expect_receipt": true,
        "extra_arguments": []
      },
      "platforms": {
        "macos-arm64": {
          "target": "gui_forms_correspondence",
          "bundle": "GUI.Forms Correspondence.app",
          "executable": "Contents/MacOS/GUI.Forms Correspondence",
          "bundle_identifier": "local.guiforms.correspondence",
          "fonts": "bundle-resources",
          "planned": false
        },
        "windows-x64": {
          "target": "gui_forms_correspondence_windows",
          "executable": "GUI.Forms Correspondence.exe",
          "fonts": "sibling",
          "planned": false
        },
        "linux-x64": {
          "target": "gui_forms_correspondence_linux",
          "executable": "gui-forms-correspondence",
          "fonts": "sibling",
          "planned": false
        },
        "linux-arm64": {
          "target": "gui_forms_correspondence_linux",
          "executable": "gui-forms-correspondence",
          "fonts": "sibling",
          "planned": false
        }
      }
    }
  ]
}

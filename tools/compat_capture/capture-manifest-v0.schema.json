{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gui.forms.invalid/schemas/compat-capture-v0.json",
  "title": "GUI.Forms compatibility Capture-0 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "toolVersion",
    "specimen",
    "policy",
    "assemblies",
    "apiUses",
    "customControls",
    "nativeImports",
    "summary",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "gui.forms.compat.capture/v0" },
    "toolVersion": { "type": "string" },
    "specimen": { "$ref": "#/$defs/specimen" },
    "policy": { "$ref": "#/$defs/policy" },
    "assemblies": {
      "type": "array",
      "items": { "$ref": "#/$defs/assembly" }
    },
    "apiUses": {
      "type": "array",
      "items": { "$ref": "#/$defs/apiUse" }
    },
    "customControls": {
      "type": "array",
      "items": { "$ref": "#/$defs/customControl" }
    },
    "nativeImports": {
      "type": "array",
      "items": { "$ref": "#/$defs/nativeImport" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "disposition": {
      "enum": [
        "unclassified",
        "required",
        "deferred",
        "excluded",
        "application_side_port"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sourceKind", "size", "sha256", "managedMetadata"],
      "properties": {
        "relativePath": { "type": "string" },
        "sourceKind": { "enum": ["primary", "bundle", "external"] },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "managedMetadata": { "type": "boolean" }
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "kind", "size", "storedSize", "sha256"],
      "properties": {
        "relativePath": { "type": "string" },
        "kind": { "type": "string" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "storedSize": { "$ref": "#/$defs/nonNegativeInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["majorVersion", "minorVersion", "bundleId", "fileCount", "files"],
      "properties": {
        "majorVersion": { "$ref": "#/$defs/nonNegativeInteger" },
        "minorVersion": { "$ref": "#/$defs/nonNegativeInteger" },
        "bundleId": { "type": "string" },
        "fileCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/bundleFile" }
        }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "fileName", "sha256", "size", "containerKind", "inputs"],
      "properties": {
        "label": { "type": "string" },
        "fileName": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "containerKind": { "enum": ["managed_pe", "dotnet_single_file_bundle"] },
        "bundle": { "$ref": "#/$defs/bundle" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputFile" }
        }
      }
    },
    "dispositionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "meaning"],
      "properties": {
        "name": { "$ref": "#/$defs/disposition" },
        "meaning": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceClass",
        "defaultDisposition",
        "executeTargetCode",
        "includeMethodBodyBytes",
        "includeResources",
        "redactApplicationTypeNames",
        "trackedAssemblyPatterns",
        "dispositionCatalog"
      ],
      "properties": {
        "evidenceClass": { "type": "string" },
        "defaultDisposition": { "$ref": "#/$defs/disposition" },
        "executeTargetCode": { "const": false },
        "includeMethodBodyBytes": { "const": false },
        "includeResources": { "const": false },
        "redactApplicationTypeNames": { "const": true },
        "trackedAssemblyPatterns": { "$ref": "#/$defs/stringArray" },
        "dispositionCatalog": {
          "type": "array",
          "items": { "$ref": "#/$defs/dispositionRecord" }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath", "sourceKind", "sha256", "name", "version", "culture",
        "publicKeyToken", "mvid", "machine", "definedTypeCount", "methodBodyCount",
        "references"
      ],
      "properties": {
        "relativePath": { "type": "string" },
        "sourceKind": { "enum": ["primary", "bundle", "external"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "culture": { "type": "string" },
        "publicKeyToken": { "type": "string" },
        "mvid": { "type": "string", "format": "uuid" },
        "machine": { "type": "string" },
        "targetFramework": { "type": "string" },
        "definedTypeCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "methodBodyCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "references": { "$ref": "#/$defs/stringArray" }
      }
    },
    "apiUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAssembly", "type", "memberKind", "operations", "ilOccurrenceCount",
        "metadataReference", "sourceAssemblies", "evidence", "disposition"
      ],
      "properties": {
        "targetAssembly": { "type": "string" },
        "type": { "type": "string" },
        "member": { "type": "string" },
        "signature": { "type": "string" },
        "memberKind": { "enum": ["type", "method", "field"] },
        "operations": { "$ref": "#/$defs/stringArray" },
        "ilOccurrenceCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "metadataReference": { "type": "boolean" },
        "sourceAssemblies": { "$ref": "#/$defs/stringArray" },
        "evidence": { "type": "string" },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "customControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateTypeId", "sourceAssembly", "formsBaseAssembly", "formsBaseType",
        "inheritanceDepth", "evidence", "disposition"
      ],
      "properties": {
        "privateTypeId": { "type": "string", "pattern": "^type-[0-9a-f]{24}$" },
        "sourceAssembly": { "type": "string" },
        "formsBaseAssembly": { "type": "string" },
        "formsBaseType": { "type": "string" },
        "inheritanceDepth": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "string" },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "nativeImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAssembly", "module", "entryPoint", "attributes", "count",
        "evidence", "disposition"
      ],
      "properties": {
        "sourceAssembly": { "type": "string" },
        "module": { "type": "string" },
        "entryPoint": { "type": "string" },
        "attributes": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "string" },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedAssemblyCount", "trackedApiCount", "ilObservedApiCount",
        "customControlCount", "nativeImportCount", "errorCount", "warningCount"
      ],
      "properties": {
        "managedAssemblyCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "trackedApiCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "ilObservedApiCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "customControlCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "nativeImportCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "errorCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "warningCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "subject", "message"],
      "properties": {
        "severity": { "enum": ["warning", "error"] },
        "code": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GuiForms.LoaderConsumer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <FormsReferenceDirectory>$([System.IO.Path]::GetDirectoryName('$(FormsReferencePath)'))</FormsReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms">
      <HintPath>$(FormsReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms.Primitives">
      <HintPath>$(FormsReferenceDirectory)/System.Windows.Forms.Primitives.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Private.Windows.Core">
      <HintPath>$(FormsReferenceDirectory)/System.Private.Windows.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireFormsReference" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FormsReferencePath)' == ''" Text="FormsReferencePath is required." />
    <Error Condition="!Exists('$(FormsReferencePath)')" Text="FormsReferencePath does not exist: $(FormsReferencePath)" />
    <Error Condition="!Exists('$(FormsReferenceDirectory)/System.Windows.Forms.Primitives.dll')" Text="System.Windows.Forms.Primitives reference is missing." />
    <Error Condition="!Exists('$(FormsReferenceDirectory)/System.Private.Windows.Core.dll')" Text="System.Private.Windows.Core reference is missing." />
  </Target>
</Project>

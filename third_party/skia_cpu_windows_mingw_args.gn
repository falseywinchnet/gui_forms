is_debug = false
is_official_build = true
is_component_build = false

# A native MSYS2 CLANG64 build on Windows (tools/windows_toolchain.json, the
# compiler that builds GUI.Forms): PE/COFF objects with the MinGW ABI and
# libc++, built through Skia's Unix-style GN toolchain with only its portable
# Windows file implementation (skia_windows_mingw.patch). No MSVC or Windows
# SDK toolchain is imported.
target_os = "linux"
target_cpu = "x64"
cc = "clang"
cxx = "clang++"
ar = "llvm-ar"
skia_gui_forms_mingw_port = true
extra_cflags = [
  # Skia selects Win32 spelling for force-inline/no-inline once Clang defines
  # _WIN32. Enable those language extensions without selecting the MSVC ABI.
  "-fms-extensions",
  # GUI.Forms stores BGRA8 premultiplied sRGB on every platform (stage SK).
  # The order is spelled out rather than left to Skia's platform default, here
  # and, identically, in every GUI.Forms translation unit that includes
  # Skia's headers (tools/skia_archive.py PLATFORM_DEFINES).
  "-DSK_B32_SHIFT=0",
  "-DSK_G32_SHIFT=8",
  "-DSK_R32_SHIFT=16",
  "-DSK_A32_SHIFT=24",
]

skia_enable_ganesh = false
skia_enable_graphite = false
skia_use_gl = false
skia_gl_standard = ""
skia_use_egl = false
skia_use_epoxy_egl = false
skia_use_angle = false
skia_use_metal = false
skia_use_vulkan = false
skia_use_direct3d = false
skia_use_dawn = false
skia_use_webgpu = false
skia_use_webgl = false
skia_enable_discrete_gpu = false
skia_enable_gpu_debug_layers = false

skia_enable_pdf = false
skia_enable_svg = false
skia_enable_skottie = false
skia_enable_tools = false
skia_compile_modules = false
skia_compile_sksl_tests = false
